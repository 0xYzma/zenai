# ZenAI Backend — Environment Variables
# Copy to .env and fill in your values

# ZenAI's own PostgreSQL database (for workspaces, chat logs, etc.)
ZENAI_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/zenai_db

# Client's target PostgreSQL database (the business data to query)
# In Phase 1 this is hardcoded for testing; in Phase 5 it becomes dynamic per-workspace
TARGET_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/client_db

# Gemini API Key (from Google AI Studio)
GEMINI_API_KEY=your_gemini_api_key_here

# Redis
REDIS_URL=redis://localhost:6379/0
# Set true when Redis is a required production dependency (required in integrated mode).
REQUIRE_REDIS_FOR_READINESS=true

# ChromaDB persistent directory
CHROMA_PERSIST_DIR=./chroma_data

# App settings
APP_HOST=0.0.0.0
APP_PORT=8000
ZENAI_DEBUG=true
ZENAI_MODE=standalone

# JWT Secret (change in production!)
JWT_SECRET=zenai-dev-secret-change-in-production

# NexDokandar integrated mode (server-side only)
# Set ZENAI_MODE=integrated and provide real secrets through the deployment secret manager.
SAAS_DELEGATION_PUBLIC_KEY=
SAAS_DELEGATION_ISSUER=nexdokandar-backend
SAAS_DELEGATION_AUDIENCE=nexdokandar-ai
SAAS_DELEGATION_MAX_AGE_SECONDS=300
SAAS_DELEGATION_CLOCK_SKEW_SECONDS=10
SAAS_INTERNAL_TOOLS_URL=
SAAS_INTERNAL_SERVICE_KEY=
SAAS_ANALYTICS_DATABASE_URL=
ENABLE_CURATED_TOOLS=false
ENABLE_TEXT_TO_SQL=false
MAX_TOOL_CALLS_PER_REQUEST=4
MAX_QUESTION_LENGTH=2000
AI_RESULT_ROW_LIMIT=500
AI_QUERY_TIMEOUT_MS=30000
# ADR-006: 30-day conversation retention, 90-day audit retention
CONVERSATION_RETENTION_DAYS=30
AUDIT_RETENTION_DAYS=90
